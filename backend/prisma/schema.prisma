generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WishlistItem {
  id          Int      @id @default(autoincrement())
  movieId     Int      @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  rating      Float?
  releaseDate String?
  addedAt     DateTime @default(now())
}